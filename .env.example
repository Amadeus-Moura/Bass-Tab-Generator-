# Copie este arquivo para .env e preencha os valores
# DATABASE_URL: string de conexão PostgreSQL (veja docker-compose.yml)
DATABASE_URL=postgresql://<USUARIO>:<SENHA>@localhost:5432/<BANCO>

# PORT: porta da API Express (padrão: 3001)
PORT=3001

# MOCK_USER_ID: UUID do usuário de desenvolvimento (gerado pelo `npm run db:seed`)
# ⚠️  NÃO altere após rodar o seed — o banco já terá esse ID salvo.
MOCK_USER_ID=<UUID-GERADO-PELO-SEED>
